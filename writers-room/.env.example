# Copy to .env.local for local runs (never commit real values).
# Everything is optional locally: with nothing set, the app runs with a built-in
# database in ./.data and no login.

# Your private passphrase. Required on the deployed app.
APP_PASSPHRASE=

# Supabase Postgres connection string (Transaction pooler, port 6543).
# Leave empty locally to use the built-in database.
DATABASE_URL=

# Speech-to-text (Deepgram) and transcript cleanup (Anthropic).
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Local testing only: pretend every recording said this (used when DEEPGRAM_API_KEY is empty).
# WR_FAKE_TRANSCRIPT="Um, scene note. She finds the second phone in the glove box."
