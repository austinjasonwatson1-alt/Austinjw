# Copy to .env (never commit .env). Values are read from the environment only.
GEMINI_API_KEY=
GEMINI_API_SECRET=

# Only needed for master- keys: the subaccount name, e.g. primary
GEMINI_ACCOUNT=

# sandbox (default) or production. Real money needs BOTH production and DRY_RUN=false.
GEMINI_ENV=sandbox

# true (default) or false. Only the exact value "false" places real orders.
DRY_RUN=true

# Runner research (Anthropic API). Only runner.py reads it; the Gemini server never sees it.
ANTHROPIC_API_KEY=
