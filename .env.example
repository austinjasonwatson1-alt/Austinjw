# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for research (stage 2+): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: multi-book line shopping via https://the-odds-api.com (free tier = 500 credits/month).
