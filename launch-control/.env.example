# Copy to .env.local and fill in. Server-only: never prefix these with NEXT_PUBLIC_.

# Claude API key for the readiness agent (M2). Leave empty to use the rules-engine brief.
ANTHROPIC_API_KEY=

# Linear personal API key (Settings → Security & access → Personal API keys) for live mode (M3).
LINEAR_API_KEY=
# Key of the Linear team that holds the launch projects, e.g. LCH.
LINEAR_TEAM_KEY=LCH

# Passcode the agent button asks for once per browser session on the public URL (M5).
DEMO_PASSCODE=
